# Settings API Gateway

# Gateway Port where the gateway will be executed
GATEWAY_PORT=8004

# Services URLs
AUTH_SERVICE_URL=http://0.0.0.0:8000/api/users
PROFILE_SERVICE_URL=http://0.0.0.0:8001
TRADE_SERVICE_URL=http://0.0.0.0:8002
HOME_SERVICE_URL=http://0.0.0.0:8003/api/home

# Log Settings (Optional)
LOG_LEVEL=info

UID=$(id -u)
GID=$(id -g)

# Additional Configurations
TIMEOUT=30
